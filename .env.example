APP_ENV=local
ENABLE_DEV_LIBRARIANS=false
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-local-database-password@127.0.0.1:5432/library_attendance
POSTGRES_DB=library_attendance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-database-password
SECRET_KEY=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=life.edu.ph
FRONTEND_URL=http://localhost:5173/library
FRONTEND_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_HOST_FILE=
GOOGLE_SERVICE_ACCOUNT_SECRET_ID=
AWS_REGION=
GOOGLE_WORKSPACE_DELEGATED_ADMIN=
GOOGLE_DIRECTORY_SCOPE=https://www.googleapis.com/auth/admin.directory.user.readonly
