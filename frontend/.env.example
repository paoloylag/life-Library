# Leave blank for local development; Vite proxies /api to localhost:8000.
# Set this to the public HTTPS FastAPI origin in GitHub Actions variables.
VITE_API_URL=


# Full browser URL encoded into displayed QR codes. For local phone testing,
# use this computer's LAN IP, for example http://192.168.1.20:5173/life-Library.
VITE_PUBLIC_APP_URL=
